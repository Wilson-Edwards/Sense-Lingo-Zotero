pref-title = Sense Lingo

pref-head-provider = Provider
pref-provider = Preset
pref-provider-hint = Each provider keeps its own API key, base URL and model; switching presets won't overwrite them
pref-api-key = API key
pref-base-url = Base URL (blank = preset)
pref-model = Model
pref-model-custom = Custom model
pref-model-hint = Pick one from the list above; a model the list lacks can be typed under "Custom model". Leaving it blank uses the preset default.
pref-model-use-preset = Use preset ({ $model })
pref-model-fetch = Fetch models
pref-model-status-loading = Fetching models…
pref-model-status-loaded = Loaded { $count } model(s)
pref-model-status-failed = Could not fetch models: { $error }
pref-model-status-need-key = Enter the API key first
pref-temperature = Temperature
pref-max-tokens = Max tokens
pref-disable-thinking = Disable thinking (skip the reasoning phase — faster and cheaper; on by default)
pref-disable-thinking-unsupported = This provider does not support the switch (only ClinePass is verified); switch back to ClinePass to use it.

pref-head-prefetch-provider = Pre-translation provider
pref-prefetch-provider-hint = Pre-translating a whole EPUB can use its own provider; choose "Follow translation provider" to reuse the one above.
pref-prefetch-follow = Follow translation provider
pref-prefetch-follow-hint = Following the provider above: pre-translation uses the same API key, base URL and model.

pref-head-kind = Selection kind
pref-kind-mode = Detection mode
pref-kind-auto = Auto detect
pref-kind-word = Always word
pref-kind-sentence = Always sentence
pref-word-max-words = Max words for "word"
pref-word-max-chars = Max characters

pref-head-context = Context
pref-use-context = Include the containing sentence for words
pref-context-neighbors = Include neighbouring sentences for sentences
pref-max-sentence-chars = Max context sentence length

pref-head-cache = Cache & pre-translation
pref-cache-hint = A cached word is shown instantly; a miss still calls the model and stores the answer. Pre-translation spends real API credit, so it only runs when you ask.
pref-cache-enabled = Enable the local translation cache
pref-cache-write-back = Store every successful translation (words never pre-translated fill in over time)
pref-cache-strict = Strict sentence matching (the same word in another sentence never matches — more accurate)
pref-cache-single = Use the only stored row even when its sentence differs (may show the wrong sense; use with care)
pref-prefetch-on-open = Pre-translate automatically when an EPUB is opened (spends money)
pref-prefetch-batch = Items per batch
pref-prefetch-concurrency = Concurrent requests
pref-prefetch-delay = Delay between requests (ms)
pref-prefetch-sentences = Sentences per word
pref-cache-pretranslate = Pre-translate the selected EPUB
pref-cache-stop = Stop
pref-cache-refresh = Refresh stats
pref-cache-clear = Clear cache
pref-cache-clear-confirm = Clear the whole translation cache? This cannot be undone.
pref-cache-stats = { $entries } entries · { $attachments } attachment(s) · about { $kb } KB
pref-cache-select-epub = Select an EPUB attachment in the main window first.
pref-cache-busy = A pre-translation job is already running.
pref-cache-idle = No job is running.
pref-cache-running = Analysing the book; watch for the progress window.
pref-cache-stopping = Stop requested; it will stop after the current batch.
pref-head-preprocess-tasks = Pre-translation tasks
pref-preprocess-tasks-hint = Progress and status are kept per EPUB. Resume skips entries already written; restart clears this book's cache first.
pref-task-empty = No pre-translation tasks yet.
pref-task-state-idle = Not started
pref-task-state-running = Running
pref-task-state-paused = Paused
pref-task-state-done = Complete
pref-task-state-failed = Failed
pref-task-progress = Written { $done } / { $total }; failed { $failed }
pref-task-preparing = Analysing the book…
pref-task-resume = Resume
pref-task-restart = Restart
pref-task-stop = Stop
pref-task-delete = Delete cache
pref-task-restart-confirm = Restart this book? Its existing pre-translation cache will be deleted before it starts again.
pref-task-delete-confirm = Delete this book's pre-translation cache and task record? This cannot be undone.
pref-task-stop-before-delete = Stop this book's pre-translation task before deleting its cache.
pref-task-missing = This EPUB attachment is no longer available, so the task cannot start.
pref-task-missing-book = Removed attachment (#{ $id })
pref-task-unnamed-book = EPUB attachment (#{ $id })
pref-task-open = Open this EPUB in Zotero
pref-task-open-failed = Could not open this EPUB in Zotero.

pref-head-prompts = Prompt templates
pref-prompt-hint = Each selection kind can keep several prompts; the preset selected above is the one in use. "New" starts from the built-in prompt, "Copy" duplicates the current one. Line breaks are preserved and variables such as {"{"}text{"}"}, {"{"}sentence{"}"} and {"{"}targetLang{"}"} are substituted; the selected text is appended automatically, and a blank box restores the built-in prompt.
pref-prompt-new = New
pref-prompt-copy = Copy
pref-prompt-delete = Delete
pref-prompt-name = Name
pref-prompt-copy-suffix = (copy)
pref-word-template = Word prompt
pref-sentence-template = Sentence prompt
pref-reset-profiles = Restore built-in templates (drops every custom prompt)
pref-profile-empty-reset = Template was empty; restored the built-in default

pref-head-ui = Interface & advanced
pref-show-in-popup = Show the translate button in the selection popup
pref-auto-translate = Translate automatically when text is selected (no button click)
pref-shortcut = Enable Ctrl/⌘ + Shift + T
pref-popup-font-size = Selection popup translation font size (px, 8–32)
pref-stream = Stream the response and show text as it is generated
pref-debug = Verbose logs (Help → Debug Output Logging)
pref-timeout = Request timeout (ms)

pref-help = { $name } build { $version } · { $time }
