pref-title = Sense Lingo

pref-head-provider = 服务商
pref-provider = 服务商预设
pref-provider-hint = 每个服务商单独保存 API Key、接口地址与模型，切换预设不会互相覆盖
pref-api-key = API Key
pref-base-url = 接口地址（留空使用预设）
pref-model = 模型
pref-model-custom = 自定义模型
pref-model-hint = 从上面的下拉里选一个即可；下拉里没有的模型在「自定义模型」里手填，留空表示使用预设默认模型。
pref-model-use-preset = 使用预设（{ $model }）
pref-model-fetch = 获取模型
pref-model-status-loading = 正在获取模型…
pref-model-status-loaded = 已获取 { $count } 个模型
pref-model-status-failed = 获取模型失败：{ $error }
pref-model-status-need-key = 请先填写 API Key
pref-temperature = 温度
pref-max-tokens = 最大 tokens
pref-disable-thinking = 禁止思考（不生成推理过程，更快、更省额度；默认开启）
pref-disable-thinking-unsupported = 当前服务商不支持该开关（仅 ClinePass 实测生效），切回 ClinePass 后可用。

pref-head-prefetch-provider = 预处理服务商
pref-prefetch-provider-hint = 预翻译整本 EPUB 时可单独使用一套服务商；选「跟随翻译服务商」就与上方完全一致。
pref-prefetch-follow = 跟随翻译服务商
pref-prefetch-follow-hint = 当前跟随上方服务商：预翻译使用同一套 API Key、接口地址与模型。

pref-head-kind = 选区类型
pref-kind-mode = 判定方式
pref-kind-auto = 自动判定
pref-kind-word = 一律按"词"
pref-kind-sentence = 一律按"句"
pref-word-max-words = 判为"词"的最大词数
pref-word-max-chars = 最大字符数

pref-head-context = 上下文
pref-use-context = 划词时带出所在句子（关闭后为纯词义翻译）
pref-context-neighbors = 划句时带出前后各一句
pref-max-sentence-chars = 单句上下文长度上限

pref-head-cache = 缓存与预翻译
pref-cache-hint = 命中的词直接显示本地缓存，未命中仍走 AI 并把结果写回缓存。预翻译会真实消耗 API 额度，默认需要手动触发。
pref-cache-enabled = 启用本地翻译缓存
pref-cache-write-back = 翻译成功后写入缓存（未预翻译的词也会逐渐入库）
pref-cache-strict = 严格句子匹配（同一词在不同句子里不命中，更准确）
pref-cache-single = 只有一条记录时仍然使用（可能给出错误义项，慎开）
pref-prefetch-on-open = 打开 EPUB 时自动预翻译（会直接产生费用）
pref-prefetch-batch = 每批条数
pref-prefetch-concurrency = 并发请求数
pref-prefetch-delay = 请求间隔（毫秒）
pref-prefetch-sentences = 每词最多句数
pref-cache-pretranslate = 预翻译选中的 EPUB
pref-cache-stop = 停止
pref-cache-refresh = 刷新统计
pref-cache-clear = 清空缓存
pref-cache-clear-confirm = 确定清空全部翻译缓存吗？此操作不可撤销。
pref-cache-stats = 缓存条目 { $entries } 条 · 附件 { $attachments } 个 · 约 { $kb } KB
pref-cache-select-epub = 请先在主窗口选中一个 EPUB 附件。
pref-cache-busy = 已有预翻译任务在运行。
pref-cache-idle = 当前没有运行中的任务。
pref-cache-running = 正在分析本书并准备预翻译，请留意弹出窗口。
pref-cache-stopping = 已请求停止，当前批次结束后停止。
pref-head-preprocess-tasks = 预处理任务
pref-preprocess-tasks-hint = 这里保留每本 EPUB 的进度与状态。恢复会跳过已写入的条目；重新处理会先清除该书缓存。
pref-task-empty = 暂无预处理任务。
pref-task-state-idle = 未开始
pref-task-state-running = 进行中
pref-task-state-paused = 已暂停
pref-task-state-done = 已完成
pref-task-state-failed = 失败
pref-task-progress = 已写入 { $done } / { $total }，失败 { $failed }
pref-task-preparing = 正在分析书籍…
pref-task-resume = 恢复
pref-task-restart = 重新处理
pref-task-stop = 停止
pref-task-delete = 删除缓存
pref-task-restart-confirm = 确定重新处理这本书吗？已有的预翻译缓存将被删除，随后从头开始。
pref-task-delete-confirm = 确定删除这本书的预翻译缓存和任务记录吗？此操作不可撤销。
pref-task-stop-before-delete = 请先停止这本书的预处理任务，再删除缓存。
pref-task-missing = 找不到该 EPUB 附件，无法启动任务。
pref-task-missing-book = 已移除的附件（#{ $id }）
pref-task-unnamed-book = EPUB 附件（#{ $id }）
pref-task-open = 在 Zotero 中打开此 EPUB
pref-task-open-failed = 无法在 Zotero 中打开此 EPUB。

pref-head-prompts = 提示词模板
pref-prompt-hint = 每种选区类型都可以保存多套提示词，下拉框里选中的就是当前使用的那一套。「新建」从内置模板开始，「复制」复制当前模板。直接编辑系统提示词，换行会原样保留；支持 {"{"}text{"}"}、{"{"}sentence{"}"}、{"{"}targetLang{"}"} 等变量。划选的文本会自动附在消息末尾，留空则恢复内置模板。
pref-prompt-new = 新建
pref-prompt-copy = 复制
pref-prompt-delete = 删除
pref-prompt-name = 名称
pref-prompt-copy-suffix = （副本）
pref-word-template = 划词模板
pref-sentence-template = 划句模板
pref-reset-profiles = 恢复内置默认模板（删除所有自定义模板）
pref-profile-empty-reset = 模板为空，已恢复内置默认模板

pref-head-ui = 界面与高级
pref-show-in-popup = 在划词弹窗中显示翻译按钮
pref-auto-translate = 选中文本后自动翻译（无需点击按钮）
pref-shortcut = 启用快捷键 Ctrl/⌘ + Shift + T
pref-popup-font-size = 划词弹窗内译文字号（px，8–32）
pref-stream = 流式输出（边生成边显示译文）
pref-debug = 输出调试日志（帮助 → 调试输出）
pref-timeout = 请求超时（毫秒）

pref-help = { $name } 构建 { $version } · { $time }
