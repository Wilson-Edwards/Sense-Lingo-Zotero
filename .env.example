# Copy to `.env` and fill in for `npm start` (zotero-plugin serve).

# Path to the Zotero binary (macOS: /Applications/Zotero.app/Contents/MacOS/zotero)
ZOTERO_PLUGIN_ZOTERO_BIN_PATH=

# Optional: development profile directory. Leave empty to let scaffold create one.
ZOTERO_PLUGIN_PROFILE_PATH=

# Optional: data directory used by the dev profile
ZOTERO_PLUGIN_DATA_DIR=
